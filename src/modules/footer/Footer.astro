---
import { footerNav, footerSocial } from './footer.data';
import { contact, seo } from '../../shared/config/site';
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a href="#inicio" class="brand">Damascena<span class="brand-dot">.</span>Films</a>
      <p class="footer-tagline">Produção audiovisual · {contact.region}</p>
    </div>

    <nav class="footer-col" aria-label="Navegação do rodapé">
      <h3 class="metallic-shine shine-accent">Navegação</h3>
      <ul>
        {footerNav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col">
      <h3 class="metallic-shine shine-accent">Social</h3>
      <ul>
        {
          footerSocial.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <span>{seo.brand}</span>
    <span>2026 © Todos os direitos reservados</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding: 64px 0 40px;
    position: relative;
    z-index: 2;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
  }
  .footer .brand {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .footer .brand-dot {
    color: var(--color-accent);
  }
  .footer-tagline {
    margin-top: 14px;
    max-width: 280px;
    font-size: 14px;
    color: var(--color-ink-soft);
  }
  .footer-col h3 {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-bottom: 18px;
  }
  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 11px;
    padding: 0;
  }
  .footer-col a {
    font-size: 15px;
    color: var(--color-ink-soft);
    transition: color 0.3s ease;
  }
  .footer-col a:hover {
    color: var(--color-ink);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 56px;
    padding-top: 26px;
    border-top: 1px solid var(--color-line);
    font-size: 13px;
    color: var(--color-ink-soft);
  }

  @media (max-width: 880px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 10px;
      text-align: center;
    }
  }
</style>
