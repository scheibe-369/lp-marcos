---
import { contactSection } from './contact.data';
import { buildWaLink, resolveCalLink } from '../../shared/config/site';
import CtaButton from '../../shared/ui/CtaButton.astro';

const waLink = buildWaLink();
const calLink = resolveCalLink();
// Calendário EMBUTIDO (inline) direto na página — o agendamento aparece aberto na
// seção, sem clique. O link vem do site.ts (fallback) ou da env PUBLIC_CALCOM_LINK.
---

<section id="contato" class="section divider-top contact">
  <div class="contact-halo" aria-hidden="true"></div>

  <div class="wrap contact-inner">
    <h2 class="sec-title reveal">{contactSection.title}</h2>
    <p class="contact-text reveal" style="--reveal-delay:80ms">{contactSection.text}</p>

    <div class="contact-cta reveal" style="--reveal-delay:150ms">
      <CtaButton href={waLink} label={contactSection.whatsappLabel} event="whatsapp_click" />
    </div>

    <div class="cal-wrap reveal" style="--reveal-delay:220ms">
      <p class="cal-label">{contactSection.calLabel}</p>
      <div id="cal-inline"></div>
    </div>
  </div>
</section>

<script define:vars={{ calLink }}>
  // Loader oficial do embed do Cal.com em modo INLINE — o calendário é montado
  // dentro de #cal-inline e fica aberto na página (sem popup/clique).
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () { p(api, arguments); };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  Cal('init', { origin: 'https://cal.com' });
  Cal('inline', {
    elementOrSelector: '#cal-inline',
    calLink: calLink,
    layout: 'month_view',
    config: { theme: 'dark' },
  });
  Cal('ui', {
    theme: 'dark',
    cssVarsPerTheme: { dark: { 'cal-brand': '#1568fb' } },
    hideEventTypeDetails: false,
    layout: 'month_view',
  });
</script>

<style>
  .contact {
    position: relative;
    text-align: center;
    overflow: clip;
  }
  .contact-halo {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 90vw;
    max-width: 1000px;
    aspect-ratio: 2 / 1;
    background: radial-gradient(ellipse at top, rgba(21, 104, 251, 0.12), transparent 60%);
    pointer-events: none;
  }
  .contact-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .contact .sec-title {
    max-width: 760px;
  }
  .contact-text {
    max-width: 560px;
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .contact-cta {
    margin-top: 38px;
  }

  .cal-wrap {
    width: 100%;
    margin-top: 64px;
  }
  .cal-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-soft);
    margin-bottom: 24px;
  }
  #cal-inline {
    min-height: 640px;
    width: 100%;
    max-width: 1000px;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 10px;
  }
</style>
