---
import { contactSection } from './contact.data';
import { buildWaLink, resolveCalLink } from '../../shared/config/site';
import CtaButton from '../../shared/ui/CtaButton.astro';

const waLink = buildWaLink();
const calLink = resolveCalLink();
// Só carrega o embed do Cal.com quando há slug real configurado; senão, mostra
// um placeholder elegante (evita o "calendário não encontrado" do Cal no demo).
const calConfigured = Boolean(import.meta.env.PUBLIC_CALCOM_LINK);
---

<section id="contato" class="section divider-top contact">
  <div class="contact-halo" aria-hidden="true"></div>

  <div class="wrap contact-inner">
    <h2 class="sec-title reveal">{contactSection.title}</h2>
    <p class="contact-text reveal" style="--reveal-delay:80ms">{contactSection.text}</p>

    <div class="contact-cta reveal" style="--reveal-delay:150ms">
      <CtaButton href={waLink} label={contactSection.whatsappLabel} event="whatsapp_click" />
    </div>

    <div class="cal-wrap reveal" style="--reveal-delay:220ms">
      <p class="cal-label">{contactSection.calLabel}</p>

      {
        calConfigured ? (
          <div id="cal-inline"></div>
        ) : (
          <div class="cal-placeholder">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="4.5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.3" />
              <path d="M3 9h18M8 3v3M16 3v3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
            </svg>
            <p class="cal-ph-title">Agenda do Cal.com aparece aqui</p>
            <p class="cal-hint">
              Configure <code>PUBLIC_CALCOM_LINK</code> no <code>.env</code> com o slug do Marcos
              (ex: <code>marcos/call</code>) — o calendário embute sozinho no tema escuro.
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>

{
  calConfigured && (
    <script define:vars={{ calLink }}>
      (function (C, A, L) {
        let p = function (a, ar) {
          a.q.push(ar);
        };
        let d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement('script')).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === 'string') {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ['initNamespace', namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');
      Cal('init', { origin: 'https://cal.com' });
      Cal('inline', { elementOrSelector: '#cal-inline', calLink: calLink, layout: 'month_view' });
      Cal('ui', {
        theme: 'dark',
        cssVarsPerTheme: { dark: { 'cal-brand': '#c9a96a' } },
        hideEventTypeDetails: false,
        layout: 'month_view',
      });
    </script>
  )
}

<style>
  .contact {
    position: relative;
    text-align: center;
    overflow: clip;
  }
  .contact-halo {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 90vw;
    max-width: 1000px;
    aspect-ratio: 2 / 1;
    background: radial-gradient(ellipse at top, rgba(201, 169, 106, 0.1), transparent 60%);
    pointer-events: none;
  }
  .contact-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .contact .sec-title {
    max-width: 760px;
  }
  .contact-text {
    max-width: 560px;
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .contact-cta {
    margin-top: 38px;
  }

  .cal-wrap {
    width: 100%;
    margin-top: 64px;
  }
  .cal-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-soft);
    margin-bottom: 24px;
  }
  #cal-inline {
    min-height: 600px;
    width: 100%;
    max-width: 920px;
    margin-inline: auto;
    overflow: hidden;
  }

  .cal-placeholder {
    max-width: 720px;
    margin-inline: auto;
    min-height: 320px;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 12px;
    padding: 48px 40px;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: var(--color-bg-soft);
    color: var(--color-accent);
  }
  .cal-ph-title {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--color-ink);
  }
  .cal-hint {
    max-width: 460px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .cal-hint code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    color: var(--color-accent-soft);
    background: rgba(201, 169, 106, 0.08);
    padding: 1px 6px;
    border-radius: 4px;
  }
</style>
