---
import { logos, logosTitle } from './logos.data';
// Set duplicado pro loop contínuo sem emenda (translateX 0 → -50%)
const loop = [...logos, ...logos];
---

<section id="clientes" class="section divider-top">
  <div class="wrap logos-head reveal">
    <p class="eyebrow">{logosTitle.label}</p>
    <h2 class="sec-title">{logosTitle.title}</h2>
  </div>

  <div class="marquee" aria-label="Clientes atendidos">
    <div class="marquee-track">
      {
        loop.map((l, i) => (
          <span class="logo-chip" aria-hidden={i >= logos.length ? 'true' : undefined}>
            {l.name}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .logos-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 720px;
    margin-bottom: 52px;
  }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .marquee-track {
    display: flex;
    align-items: center;
    gap: 64px;
    width: max-content;
    animation: marquee 35s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  /* Chips de texto (placeholder). Cor cheia garante contraste AA; logos reais
     em imagem podem voltar a usar opacity/grayscale sem flag de contraste. */
  .logo-chip {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--color-ink-soft);
    transition: color 0.3s ease;
  }
  .logo-chip:hover {
    color: var(--color-ink);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 24px;
    }
    /* fileira estática não precisa do set duplicado */
    .logo-chip:nth-child(n + 9) {
      display: none;
    }
  }
</style>
