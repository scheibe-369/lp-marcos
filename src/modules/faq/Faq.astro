---
import { faq, faqTitle } from './faq.data';
---

<section id="faq" class="section divider-top">
  <div class="wrap faq-wrap">
    <header class="faq-head reveal">
      <p class="eyebrow">{faqTitle.label}</p>
      <h2 class="sec-title">{faqTitle.title}</h2>
    </header>

    <div class="faq-list">
      {
        faq.map((item, i) => (
          <details class="faq-item reveal" style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <summary class="faq-summary">
              <span class="faq-q">{item.q}</span>
              <span class="faq-marker" aria-hidden="true" />
            </summary>
            <div class="faq-answer">
              <div class="faq-answer-inner">
                <p>{item.a}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-wrap {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 60px;
    align-items: start;
  }
  .faq-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: sticky;
    top: 110px;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-line);
  }
  .faq-item:first-child {
    border-top: 1px solid var(--color-line);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    font-size: 18px;
    font-weight: 500;
    color: var(--color-ink);
    transition: color 0.3s ease;
  }
  .faq-item:hover .faq-q {
    color: var(--color-accent-soft);
  }

  /* Marcador +/− */
  .faq-marker {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--color-accent);
  }
  .faq-marker::before,
  .faq-marker::after {
    content: '';
    position: absolute;
    background: currentColor;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .faq-marker::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    transform: translateY(-50%);
  }
  .faq-marker::after {
    left: 50%;
    top: 0;
    width: 1.5px;
    height: 100%;
    transform: translateX(-50%);
  }
  .faq-item[open] .faq-marker::after {
    opacity: 0;
    transform: translateX(-50%) scaleY(0);
  }

  /* Resposta — abertura suave via grid-template-rows */
  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }
  .faq-item[open] .faq-answer {
    grid-template-rows: 1fr;
  }
  .faq-answer-inner {
    overflow: hidden;
  }
  .faq-answer-inner p {
    padding-bottom: 22px;
    max-width: 60ch;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  @media (max-width: 880px) {
    .faq-wrap {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .faq-head {
      position: static;
    }
  }
</style>
