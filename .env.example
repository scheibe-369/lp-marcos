# Copie para .env e preencha quando for rodar tráfego.
# Todos os IDs aqui são PÚBLICOS por natureza (vão pro client). Prefixo PUBLIC_ é obrigatório no Astro.

# --- Tracking (deixe vazio até rodar tráfego pago) ---
PUBLIC_META_PIXEL_ID=
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=

# --- Agendamento ---
# Slug do Cal.com do Marcos, ex: marcos/call.
# Se vazio, o site usa o fallback de src/shared/config/site.ts (contact.calLink).
PUBLIC_CALCOM_LINK=
